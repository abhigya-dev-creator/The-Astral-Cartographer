# Copy this file to .env (same folder) and fill in your own values. Never commit .env.

# --- required ---
# Supabase project URL and anon/publishable key (Supabase dashboard > Project Settings > API).
# Must be the same Supabase project as the client's VITE_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# MongoDB connection string, e.g. a free MongoDB Atlas cluster: mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/astral
# Leave empty for a throwaway in-memory database during local development (data is lost when the server stops).
MONGODB_URI=

# --- optional ---
# Port of the analysis server. The client's dev proxy expects 5000.
PORT=5000
# Allowed browser origins, comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GitHub personal access token (no scopes needed) to raise GitHub's rate limit when importing repositories.
GITHUB_TOKEN=
# true = use an in-memory database even when MONGODB_URI is set (testing only).
ALLOW_IN_MEMORY_DB=
# How many times to try connecting to MONGODB_URI at startup before giving up (default 4).
DB_CONNECT_ATTEMPTS=
# How many analyses may run at the same time, and how many analyze requests one user may make per 10 minutes.
MAX_CONCURRENT_ANALYSES=
ANALYZE_RATE_LIMIT=

# AI companion (Groq). Get a key at https://console.groq.com/keys; model is optional.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
