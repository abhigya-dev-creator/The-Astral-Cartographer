   "resolution": {
    "kind": "local",
    "target": "src/logo.svg",
    "via": "relative"
   }
  },
  {
   "importer": "src/App.tsx",
   "specifier": "./config.json",
   "resolution": {
    "kind": "local",
    "target": "src/config.json",
    "via": "relative"
   }
  }
 ],
