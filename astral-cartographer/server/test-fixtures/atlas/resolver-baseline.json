  },
  {
   "importer": "src/c.ts",
   "specifier": "./a",
   "resolution": {
    "kind": "local",
    "target": "src/a.ts",
    "via": "relative"
   }
  },
  {
   "importer": "src/d.ts",
   "specifier": "./e",
   "resolution": {
    "kind": "local",
    "target": "src/e.ts",
    "via": "relative"
   }
  },
  {
   "importer": "src/e.ts",
   "specifier": "./d",
   "resolution": {
    "kind": "local",
    "target": "src/d.ts",
    "via": "relative"
   }
  },
  {
   "importer": "src/leaf.ts",
   "specifier": "./a",
   "resolution": {
    "kind": "local",
    "target": "src/a.ts",
    "via": "relative"
   }
  }
 ],
 "dynamic-imports": [
  {
   "importer": "src/router.ts",
   "specifier": "./pages/Lazy",
   "resolution": {
    "kind": "local",
    "target": "src/pages/Lazy.ts",
